<!-- Confines per-keystroke reactivity to this component's subtree, per
     https://docs.xmlui.org/howto/confine-a-hot-input-to-its-own-component.
     The debounced ChangeListener emits the committed term to the parent,
     so App-scope bindings (getPagedEvents, EventCard list) re-evaluate at
     most once per pause instead of on every keystroke. -->
<Component name="SearchBox" var.draft="{$props.initialValue || ''}" var.lastSent="{$props.initialValue || ''}">
  <HStack verticalAlignment="center" gap="$space-1" width="100%">
    <TextBox
      id="box"
      autoFocus="false"
      placeholder="Search events..."
      fontSize="$fontSize-sm"
      initialValue="{$props.initialValue || ''}"
      onDidChange="(val) => draft = val"
      width="*"
    />
    <!-- Clear path: emit 'clear' to the parent immediately, then reset the
         TextBox. Per the XMLUI docs, setValue triggers onDidChange, which
         would schedule a trailing debounced search('') 250ms later — a
         redundant re-render. We pre-set lastSent='' so the ChangeListener
         sees the trailing change as a duplicate of what was already sent
         and drops it. If the user types again before the 250ms window,
         the new value differs from lastSent and emits normally. -->
    <Icon
      name="close"
      tooltip="Clear search"
      width="20px"
      height="20px"
      cursor="pointer"
      color="$color-text-tertiary"
      opacity="{draft ? 1 : 0}"
      onClick="emitEvent('clear'); lastSent = ''; box.setValue('')"
    />
  </HStack>
  <ChangeListener
    listenTo="{draft}"
    debounceWaitInMs="250"
    onDidChange="(change) => { if (change.newValue === lastSent) return; lastSent = change.newValue; emitEvent('search', change.newValue); }"
  />
  <method name="setValue">
    (v) => box.setValue(v)
  </method>
</Component>
