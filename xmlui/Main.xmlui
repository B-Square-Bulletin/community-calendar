<App
  name="Community Calendar"
  defaultTheme="{window.ccThemeId || 'community-calendar'}"
  fitContent="{window.ccAutoHeight}"
  var.filterTerm="{window.initialSearch || ''}"
  var.viewMode="{'all'}"
  var.displayStartIndex="{0}"
  var.browseStartIndex="{0}"
  global.scrollRequest="{0}"
  global.picksData="{null}"
  global.userSettingsData="{window._localHiddenSources ? [{ hidden_sources: window._localHiddenSources }] : null}"
  global.authUser="{authUser}"
  global.authSession="{authSession}"
  var.city="{window.cityFilter || null}"
  global.isAdmin="{false}"
  global.activePanel="{''}"
  var.datePreset="{window.initialDatePreset || 'all'}"
  var.dateWindowStart="{window.initialDateStart || null}"
  var.dateWindowEnd="{window.initialDateEnd || null}"
  var.dateTruncationLabel="{window.initialDateTruncationLabel || null}"
  var.customOpen="{window.initialDatePreset === 'custom'}">

  <!-- DataSources -->
  <!-- Events arrive via PushSource from the shell.js boot-time prefetch:
       cached rows (IndexedDB) may paint first, then fresh rows replace them
       when the network fetch lands. See window.subscribeEvents in shell.js. -->
  <PushSource
    id="events"
    when="{city}"
    subscribe="{window.subscribeEvents}"
  />

  <DataSource
    id="picks"
    when="{authSession}"
    url="{appGlobals.supabaseUrl + '/rest/v1/picks?select=*,events(*)'}"
    headers="{{
      apikey: appGlobals.supabasePublishableKey,
      Authorization: 'Bearer ' + authSession?.access_token,
      'Cache-Control': 'no-cache, no-store, must-revalidate'
    }}"
  />

  <DataSource
    id="userSettings"
    when="{authSession && city}"
    url="{appGlobals.supabaseUrl + '/rest/v1/user_settings?select=*&city=eq.' + city + '&limit=1'}"
    headers="{{
      apikey: appGlobals.supabasePublishableKey,
      Authorization: 'Bearer ' + authSession?.access_token,
      'Cache-Control': 'no-cache, no-store, must-revalidate'
    }}"
  />

  <ChangeListener
    listenTo="{picks.value}"
    onDidChange="() => picksData = picks.value"
  />

  <ChangeListener
    listenTo="{enrichments.value}"
    onDidChange="() => enrichmentsData = enrichments.value"
  />

  <ChangeListener
    listenTo="{userSettings.value}"
    onDidChange="() => { if (userSettings.value && userSettings.value.length) { userSettingsData = userSettings.value; const s = userSettingsData[0]; if (s) { if (s.layout_mode && !window.embed && !window.hasLayoutModeParam) { window.setLayoutMode(s.layout_mode); layoutMode = s.layout_mode } if (s.image_mode && !window.hasImagesParam) { window.setShowListImages(s.image_mode === 'everywhere' ? 'list' : 'preview'); showListImages = (s.image_mode !== 'preview') } oneClickPick = !!s.one_click_pick } } }"
  />

  <DataSource
    id="dashboardSettings"
    when="{authSession}"
    url="{appGlobals.supabaseUrl + '/rest/v1/user_settings?select=dashboard&city=eq._dashboard&limit=1'}"
    headers="{{
      apikey: appGlobals.supabasePublishableKey,
      Authorization: 'Bearer ' + authSession?.access_token,
      'Cache-Control': 'no-cache, no-store, must-revalidate'
    }}"
  />

  <ChangeListener
    listenTo="{dashboardSettings.value}"
    onDidChange="() => { if (dashboardTiles !== null) return; const d = dashboardSettings.value; if (d && d[0] && d[0].dashboard) { dashboardTiles = d[0].dashboard.tiles || []; dashboardGridLayout = d[0].dashboard.gridLayout || []; } else { dashboardTiles = []; dashboardGridLayout = []; } }"
  />

  <ChangeListener
    listenTo="{picksCounter}"
    onDidChange="picks.refetch(); enrichments.refetch()"
  />

  <ChangeListener
    listenTo="{eventsCounter}"
    onDidChange="window.refetchEvents()"
  />

  <!-- filterTerm ChangeListener removed: TextBox onDidChange already sets displayStartIndex -->



  <ChangeListener
    listenTo="{scrollRequest}"
    onDidChange="topAnchor.scrollIntoView()"
  />

  <DataSource
    id="feedToken"
    when="{authSession}"
    url="{appGlobals.supabaseUrl + '/rest/v1/feed_tokens?select=token&limit=1'}"
    headers="{{
      apikey: appGlobals.supabasePublishableKey,
      Authorization: 'Bearer ' + authSession?.access_token
    }}"
  />

  <DataSource
    id="adminAccess"
    when="{authSession}"
    url="{appGlobals.supabaseUrl + '/rest/v1/admin_users?select=user_id&user_id=eq.' + authUser?.id + '&limit=1'}"
    headers="{{
      apikey: appGlobals.supabasePublishableKey,
      Authorization: 'Bearer ' + authSession?.access_token
    }}"
  />

  <DataSource
    id="enrichments"
    when="{city}"
    url="{appGlobals.supabaseUrl + '/rest/v1/event_enrichments?select=*&rrule=not.is.null' + (city ? '&city=eq.' + city : '')}"
    headers="{{
      apikey: appGlobals.supabasePublishableKey,
      'Cache-Control': 'no-cache, no-store, must-revalidate'
    }}"
  />

  <ChangeListener
    listenTo="{adminAccess.value}"
    onDidChange="() => isAdmin = (adminAccess.value || []).length > 0"
  />

  <variable name="hiddenSources" value="{(userSettingsData && userSettingsData[0] && userSettingsData[0].hidden_sources) || window._localHiddenSources || []}" />
  <variable name="expandedEnrichments" value="{window.expandEnrichments(enrichments.value, window.getFromDate(), window.getToDate()) || []}" />
  <variable name="combinedEvents" value="{window.combineEvents(events.value, expandedEnrichments)}" />
  <variable name="processedEvents" value="{window.processEvents(combinedEvents, hiddenSources)}" />
  <!-- Single committed date window (#105): one absolute {start, end} feeds
       both the rendered list and the pager guard below (prio-90: the window
       travels as one object, not loose bounds). All is null bounds
       (the prefetched set passes through); Tonight is start-time-only per
       #103 (flagged all-day, midnight-anchored, and continuations excluded);
       Picks and Dashboard ignore it. -->
  <variable name="dateFilteredEvents" value="{window.filterByDateWindow(processedEvents, {start: dateWindowStart, end: dateWindowEnd}, {startTimeOnly: datePreset === 'tonight'})}" />

  <variable name="availableCities" value="{Object.keys(window._cities || {}).sort().map(city => ({ city }))}" />

  <!-- City picker (shown when no city selected and not in dashboard mode) -->
  <IncludeMarkup when="{!city && layoutMode !== 'dashboard' && !window.embed}" url="{'components/BrandHeader.xmlui?v=' + window.APP_VERSION}" />
  <VStack when="{!city && layoutMode !== 'dashboard'}" horizontalAlignment="center" width="100%" padding="$space-8">
    <VStack gap="$space-4" maxWidth="300px" width="100%">
      <VStack gap="$space-2">
        <Items data="{availableCities}">
          <Button variant="outlined" width="100%" onClick="window.selectCity($item.city); city = $item.city">{window.toDisplayName($item.city)}</Button>
        </Items>
      </VStack>
    </VStack>
  </VStack>
  <IncludeMarkup when="{!city && layoutMode !== 'dashboard' && !window.embed}" url="{'components/BrandFooter.xmlui?v=' + window.APP_VERSION}" />

  <!-- Main Content -->
  <IncludeMarkup when="{!!city && layoutMode !== 'dashboard' && !window.embed}" url="{'components/BrandHeader.xmlui?v=' + window.APP_VERSION}" />
  <HStack when="{!!city && layoutMode !== 'dashboard'}" horizontalAlignment="center" width="100%" overflowX="hidden">
  <VStack maxWidth="{layoutMode === 'multicol' ? '1200px' : '600px'}" width="100%" overflowX="hidden">
    <VStack>
    <VStack gap="$space-2">
    <Bookmark id="topAnchor">
      <H1>
        <HStack width="100%" verticalAlignment="center">
          <Text overflowMode="ellipsis" maxLines="1" width="*">{window.toDisplayName(city)}</Text>
          <IncludeMarkup when="{!window.embed}" url="{'components/IconRow.xmlui?v=' + window.APP_VERSION}" />
          <HStack when="{window.embed}" gap="$space-1" verticalAlignment="center">
            <Icon
              name="l-rss"
              tooltip="Sources"
              width="20px"
              height="20px"
              color="{activePanel === 'sources' ? '$color-primary-600' : '$color-surface-500'}"
              backgroundColor="{activePanel === 'sources' ? '$color-surface-200' : 'transparent'}"
              borderRadius="999px"
              padding="$space-0_5"
              onClick="sourcesDialog.toggle()" />
            <Inspector src="{'xmlui/xs-diff.html?v=' + window.APP_VERSION}" />
          </HStack>
        </HStack>
      </H1>
    </Bookmark>
    <VStack
      width="100%"
      minHeight="{getInlinePanelHostMinHeight(activePanel)}"
      height="{getInlinePanelHostHeight(activePanel)}"
      overflowY="{getInlinePanelHostOverflow(activePanel)}"
      overflowX="hidden">
      <SignInDialog id="signInDialog" />
      <CaptureDialog id="captureDialog" />
      <AudioCaptureDialog id="audioCaptureDialog" />
      <SourcesDialog id="sourcesDialog" events="{events.value}" city="{city}" hiddenSources="{hiddenSources}" />
      <Card
        when="{activePanel === 'settings'}"
        width="100%"
        marginTop="$space-3"
        marginBottom="$space-3"
        padding="$space-3"
        gap="$space-3">
        <HStack verticalAlignment="start" gap="$space-2">
          <H3 width="*">Display Settings</H3>
          <Icon
            name="close"
            tooltip="Hide settings"
            width="20px"
            height="20px"
            color="$color-text-secondary"
            onClick="activePanel = ''" />
        </HStack>
        <HStack verticalAlignment="start" gap="$space-6">
          <VStack gap="$space-1">
            <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm">Layout</Text>
            <RadioGroup initialValue="{layoutMode}" onDidChange="(val) => { window.setLayoutMode(val); layoutMode = val; if (authSession) { userSettingsData = window.saveUserSetting({ layout_mode: val }, userSettingsData, appGlobals.supabaseUrl, appGlobals.supabasePublishableKey) } }">
              <VStack>
                <Option value="list" label="Single column" fontSize="$fontSize-sm" />
                <Option value="multicol" label="Multi column" fontSize="$fontSize-sm" />
                <Option when="{!!authSession}" value="dashboard" label="Dashboard" fontSize="$fontSize-sm" />
              </VStack>
            </RadioGroup>
          </VStack>
          <VStack gap="$space-1">
            <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm">Images</Text>
            <RadioGroup initialValue="{showListImages ? 'list' : 'preview'}" onDidChange="(val) => { window.setShowListImages(val); showListImages = (val !== 'preview'); if (authSession) { userSettingsData = window.saveUserSetting({ image_mode: val === 'preview' ? 'preview' : 'everywhere' }, userSettingsData, appGlobals.supabaseUrl, appGlobals.supabasePublishableKey) } }">
              <VStack>
                <Option value="list" label="Everywhere" fontSize="$fontSize-sm" />
                <Option value="preview" label="Only in previews" fontSize="$fontSize-sm" />
              </VStack>
            </RadioGroup>
          </VStack>
        </HStack>
        <VStack when="{!!authSession}" gap="$space-1">
          <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm">Picks</Text>
          <Checkbox
            label="One-click pick (skip editor)"
            initialValue="{oneClickPick}"
            onDidChange="(val) => { if (val !== oneClickPick) { oneClickPick = val; window.saveUserSetting({ one_click_pick: val }, userSettingsData, appGlobals.supabaseUrl, appGlobals.supabasePublishableKey) } }"
          />
        </VStack>
      </Card>
      <AddFeedDialog id="addFeedDialog" />
      <PickEditor when="{!!pickEvent && activePanel === 'pick'}" event="{pickEvent}" onClose="closePickEditor()" onSaved="picksCounter = picksCounter + 1" />
    </VStack>
    <HStack verticalAlignment="center" marginBottom="$space-2" gap="$space-2">
      <SearchBox
        id="searchBox"
        width="*"
        initialValue="{window.initialSearch || ''}"
        onSearch="(val) => { filterTerm = val; displayStartIndex = browseStartIndex; window.syncSearchParam(val); }"
        onClear="setCategoryFilter(''); window.syncSearchParam(''); filterTerm = ''; displayStartIndex = 0; browseStartIndex = 0; scrollRequest = scrollRequest + 1"
      />
      <Select
        id="categorySelect"
        aria-label="Event category"
        placeholder="All categories"
        clearable="true"
        fontSize="$fontSize-sm"
        dropdownHeight="520px"
        value="{categoryFilter || undefined}"
        onDidChange="(val) => { categoryFilter = val || ''; window.syncCategoryParam(categoryFilter); }"
        width="*"
      >
        <Items data="{window.getActiveCategories(dateFilteredEvents)}">
          <Option value="{$item.name}" label="{$item.label}" />
        </Items>
      </Select>
    </HStack>
    <RadioGroup when="{authUser}" initialValue="{viewMode}" onDidChange="(val) => viewMode = val">
      <HStack>
        <Option value="all" label="list" />
        <Option value="picks" label="my picks" />
      </HStack>
    </RadioGroup>
    <!-- Date-tab strip (#105 day presets + #106 intraday tabs + #107 Custom):
         every preset tap commits through the single commitDatePreset path in
         Globals.xs — one absolute window feeds the list and the pager,
         paging resets plus scroll-to-top fire on commit only, and the commit
         syncs the URL with history-replace. Tonight is start-time-only from
         5pm city-time; the weekend is Fri 17:00 through Sunday night
         (engine-resolved per weekday). The Custom tab opens the stock
          range picker below; the picker commits on explicit confirm only
          (Cancel/Proceed footer, never per tick or mid-drag). #108: the heading gives the strip an
         accessible name and is the empty-reset focus target; preset commits
         surface the horizon-truncation label. -->
    <Text id="dateTabHeading" fontSize="$fontSize-sm" fontWeight="$fontWeight-bold" value="Filter by date" />
    <HStack id="dateTabStrip" verticalAlignment="center" gap="$space-1" wrapContent="true" width="100%" marginBottom="$space-2">
      <Button variant="{datePreset === 'all' && !customOpen ? 'solid' : 'outlined'}" onClick="commitDatePreset('all')">All dates</Button>
      <Button variant="{datePreset === 'today' && !customOpen ? 'solid' : 'outlined'}" onClick="commitDatePreset('today')">Today</Button>
      <Button variant="{datePreset === 'tonight' && !customOpen ? 'solid' : 'outlined'}" onClick="commitDatePreset('tonight')">Tonight</Button>
      <Button variant="{datePreset === 'tomorrow' && !customOpen ? 'solid' : 'outlined'}" onClick="commitDatePreset('tomorrow')">Tomorrow</Button>
      <Button variant="{datePreset === 'weekend' && !customOpen ? 'solid' : 'outlined'}" onClick="commitDatePreset('weekend')">This weekend</Button>
      <Button variant="{datePreset === 'next7' && !customOpen ? 'solid' : 'outlined'}" onClick="commitDatePreset('next7')">Next 7 days</Button>
      <Button variant="{datePreset === 'thismonth' && !customOpen ? 'solid' : 'outlined'}" onClick="commitDatePreset('thismonth')">This month</Button>
      <Button variant="{(datePreset === 'custom' || customOpen) ? 'solid' : 'outlined'}" onClick="customOpen = true; window.openCustomPicker()">Custom</Button>
    </HStack>
    <!-- Custom range picker (#107): stock range control with date-only
         format, the city timezone, today minimum plus past dates disabled,
         and explicit confirm (Cancel/Proceed footer — nothing commits
         mid-drag or per tick). Divergence from #103/#107 spec: the spec
         required boot-computed forward presets (Next 7, Next 30, This
         month) in the picker sidebar, but Next 7 / This month duplicated
         the tab strip with divergent URL semantics (evergreen ?date= vs
         absolute ?from/&to=), leaving only Next 30 unique — so the
         sidebar was removed outright and Custom means arbitrary range
         only. The row mounts only while the Custom flow is open
         (customOpen, seeded true on a custom deep-link): opening mounts
         without committing, and every non-custom commit closes it via the
         shared commitDatePreset path, so the range display can never
         disagree with the committed window. The Custom tab is the single
         entry point: it mounts the row and calls window.openCustomPicker(),
         which clicks the picker's Control element — the path that opens the
         popup for a programmatic trigger (focus() merely selects the date
         text: the vendored handle exposes no open API). The in-box calendar
         glyph (endIcon) is a plain adornment inside that same Control, so
         tapping it opens the popup too. Tapping Custom again re-opens a
         dismissed popup. Commit fires once on explicit confirm (Proceed
         via onDidChange): malformed or partial input is ignored, past starts clamp,
         inverted ranges coerce to a single day, and the canonical
         exact-date link syncs (prio-90: the committed window travels as
         one object). Manual typing alone never commits. -->
    <HStack id="customPickerRow" when="{customOpen}" verticalAlignment="center" gap="$space-2" width="100%">
      <DatePicker
        id="customRangePicker"
        mode="range"
        label="Custom date range"
        placeholder="Select start and end dates"
        dateFormat="yyyy-MM-dd"
        timeZone="{window.customPickerTimezone()}"
        startDate="{window.todayDateOnly()}"
        disabledDates="{window.customDisabledDates()}"
        endIcon="calendar-days"
        confirmRangeSelection="true"
        onDidChange="(val) => { const customWindow = window.dateWindowForCustom(val); if (!customWindow) return; datePreset = 'custom'; dateWindowStart = customWindow.start; dateWindowEnd = customWindow.end; dateTruncationLabel = window.dateTruncationText(customWindow); displayStartIndex = 0; browseStartIndex = 0; scrollRequest = scrollRequest + 1; window.syncCustomParams(customWindow); }"
      />
    </HStack>
    <Text when="{dateTruncationLabel}" fontSize="$fontSize-sm" color="$color-text-secondary" value="{dateTruncationLabel}" />
    <!-- Empty window (#108): an explicit message plus a one-tap reset to
         Next 7 days. The guard reads the full filtered list (date + search
         + category), not the paged slice, so a stale displayStartIndex on a
         later page can never misreport "No events" when matches exist on
         page 1. The reset commits through the shared commitDatePreset
         path with scrolling off (paging reset, URL sync) but moves focus to
         the tab-strip heading with no scroll instead of firing
         scroll-to-top. -->
    <VStack when="{!!events.value && viewMode === 'all' && !window.filterEvents(dateFilteredEvents, filterTerm, categoryFilter).length}" gap="$space-2" width="100%" padding="$space-3" horizontalAlignment="center">
      <Text value="{'No events ' + window.dateWindowLabel(datePreset) + '.'}" />
      <Button variant="outlined" onClick="commitDatePreset('next7', {scroll: false}); window.focusDateTabHeading()">Show next 7 days</Button>
    </VStack>
    </VStack>
    </VStack>
    <Spinner when="{!events.value && viewMode === 'all'}" />
    <Button
      when="{!!events.value && viewMode === 'all' && !filterTerm && moreHasPrev(displayStartIndex)}"
      label="Earlier"
      variant="outlined"
      width="100%"
      marginBottom="$space-2"
      onClick="const prevIndex = morePrevIndex(displayStartIndex, pageSizeFor(filterTerm)); displayStartIndex = prevIndex; browseStartIndex = prevIndex; scrollRequest = scrollRequest + 1;"
    />
    <Masonry when="{!!events.value && viewMode === 'all' && layoutMode === 'multicol'}" data="{getPagedEvents(dateFilteredEvents, filterTerm, displayStartIndex, pageSizeFor(filterTerm), categoryFilter)}" columns="3" gap="$space-3" rowGap="0" minColumnWidth="300px">
      <EventCard event="{$item}" filterTerm="{filterTerm}" categoryColorMap="{window.categoryColorMap}" categoryList="{window.categoryList}" />
    </Masonry>
    <VStack when="{!!events.value && viewMode === 'all' && layoutMode !== 'multicol'}" gap="$space-0">
      <Items data="{getPagedEvents(dateFilteredEvents, filterTerm, displayStartIndex, pageSizeFor(filterTerm), categoryFilter)}">
        <EventCard event="{$item}" filterTerm="{filterTerm}" categoryColorMap="{window.categoryColorMap}" categoryList="{window.categoryList}" />
      </Items>
    </VStack>
    <Button
      when="{!!events.value && viewMode === 'all' && !filterTerm && moreHasMore(dateFilteredEvents, displayStartIndex, pageSizeFor(filterTerm))}"
      label="Later"
      variant="outlined"
      width="100%"
      marginTop="$space-2"
      onClick="const nextIndex = moreNextIndex(displayStartIndex, pageSizeFor(filterTerm)); displayStartIndex = nextIndex; browseStartIndex = nextIndex; scrollRequest = scrollRequest + 1;"
    />
    <VStack when="{viewMode === 'picks'}" gap="$space-2">
      <Text fontSize="$fontSize-sm" value="{(picks.value || []).length + ' events'}" />
      <Text fontSize="$fontSize-xs" color="$color-text-secondary">Calendar feed for your picks:</Text>
      <Text fontSize="$fontSize-xs" overflowMode="flow" value="{feedToken.value && feedToken.value[0] ? appGlobals.supabaseUrl + '/functions/v1/my-picks?token=' + feedToken.value[0].token : ''}" />
      <HStack verticalAlignment="center" gap="$space-1" wrapContent="true" width="100%">
        <Button
          size="xs"
          icon="l-copy"
          onClick="navigator.clipboard.writeText(appGlobals.supabaseUrl + '/functions/v1/my-picks?token=' + feedToken.value[0].token); toast('Copied', { duration: 1500 })"
        />
        <Text fontSize="$fontSize-xs" color="$color-text-secondary" overflowMode="flow">Click to copy link, paste into your calendar app to subscribe.</Text>
      </HStack>
      <List data="{picks.value || []}" fixedItemSize="true" limit="100">
        <PickItem pick="{$item}" />
      </List>
    </VStack>
  </VStack>
  </HStack>
  <IncludeMarkup when="{!!city && layoutMode !== 'dashboard' && !window.embed}" url="{'components/BrandFooter.xmlui?v=' + window.APP_VERSION}" />

  <!-- Dashboard mode (gate on settings loaded to avoid flash of default state) -->
  <Spinner when="{layoutMode === 'dashboard' && authSession && dashboardTiles === null}" />
  <IncludeMarkup when="{layoutMode === 'dashboard' && !window.embed}" url="{'components/BrandHeader.xmlui?v=' + window.APP_VERSION}" />
  <VStack when="{layoutMode === 'dashboard' && (dashboardTiles !== null)}" width="100%" padding="$space-3">
    <H1>
      <HStack width="100%" verticalAlignment="center">
        <Text overflowMode="ellipsis" maxLines="1" width="*">{window.cityName || 'Community Calendar'}</Text>
        <IncludeMarkup when="{!window.embed}" url="{'components/IconRow.xmlui?v=' + window.APP_VERSION}" />
        <HStack when="{window.embed}" gap="$space-1" verticalAlignment="center">
          <Icon
            name="l-rss"
            tooltip="Sources"
            width="20px"
            height="20px"
            color="{activePanel === 'sources' ? '$color-primary-600' : '$color-surface-500'}"
            backgroundColor="{activePanel === 'sources' ? '$color-surface-200' : 'transparent'}"
            borderRadius="999px"
            padding="$space-0_5"
            onClick="sourcesDialog.toggle()" />
          <Inspector src="{'xmlui/xs-diff.html?v=' + window.APP_VERSION}" />
        </HStack>
      </HStack>
    </H1>
    <VStack
      width="100%"
      minHeight="{getInlinePanelHostMinHeight(activePanel)}"
      height="{getInlinePanelHostHeight(activePanel)}"
      overflowY="{getInlinePanelHostOverflow(activePanel)}"
      overflowX="hidden">
      <SignInDialog id="signInDialog" />
      <CaptureDialog id="captureDialog" />
      <AudioCaptureDialog id="audioCaptureDialog" />
      <SourcesDialog id="sourcesDialog" events="{events.value}" city="{city}" hiddenSources="{hiddenSources}" />
      <Card
        when="{activePanel === 'settings'}"
        width="100%"
        marginTop="$space-3"
        marginBottom="$space-3"
        padding="$space-3"
        gap="$space-3">
        <HStack verticalAlignment="start" gap="$space-2">
          <H3 width="*">Display Settings</H3>
          <Icon
            name="close"
            tooltip="Hide settings"
            width="20px"
            height="20px"
            color="$color-text-secondary"
            onClick="activePanel = ''" />
        </HStack>
        <HStack verticalAlignment="start" gap="$space-6">
          <VStack gap="$space-1">
            <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm">Layout</Text>
            <RadioGroup initialValue="{layoutMode}" onDidChange="(val) => { window.setLayoutMode(val); layoutMode = val; if (authSession) { userSettingsData = window.saveUserSetting({ layout_mode: val }, userSettingsData, appGlobals.supabaseUrl, appGlobals.supabasePublishableKey) } }">
              <VStack>
                <Option value="list" label="Single column" fontSize="$fontSize-sm" />
                <Option value="multicol" label="Multi column" fontSize="$fontSize-sm" />
                <Option when="{!!authSession}" value="dashboard" label="Dashboard" fontSize="$fontSize-sm" />
              </VStack>
            </RadioGroup>
          </VStack>
          <VStack gap="$space-1">
            <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm">Images</Text>
            <RadioGroup initialValue="{showListImages ? 'list' : 'preview'}" onDidChange="(val) => { window.setShowListImages(val); showListImages = (val !== 'preview'); if (authSession) { userSettingsData = window.saveUserSetting({ image_mode: val === 'preview' ? 'preview' : 'everywhere' }, userSettingsData, appGlobals.supabaseUrl, appGlobals.supabasePublishableKey) } }">
              <VStack>
                <Option value="list" label="Everywhere" fontSize="$fontSize-sm" />
                <Option value="preview" label="Only in previews" fontSize="$fontSize-sm" />
              </VStack>
            </RadioGroup>
          </VStack>
        </HStack>
        <VStack when="{!!authSession}" gap="$space-1">
          <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm">Picks</Text>
          <Checkbox
            label="One-click pick (skip editor)"
            initialValue="{oneClickPick}"
            onDidChange="(val) => { if (val !== oneClickPick) { oneClickPick = val; window.saveUserSetting({ one_click_pick: val }, userSettingsData, appGlobals.supabaseUrl, appGlobals.supabasePublishableKey) } }"
          />
        </VStack>
      </Card>
      <AddFeedDialog id="addFeedDialog" />
      <PickEditor when="{!!pickEvent && activePanel === 'pick'}" event="{pickEvent}" onClose="closePickEditor()" onSaved="picksCounter = picksCounter + 1" />
    </VStack>
    <DashboardView />
  </VStack>
  <IncludeMarkup when="{layoutMode === 'dashboard' && !window.embed}" url="{'components/BrandFooter.xmlui?v=' + window.APP_VERSION}" />
</App>
