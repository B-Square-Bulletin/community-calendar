*.xmlui linguist-language=xml

# Keep fork's versions of generated/config files during upstream merges.
# Forks: run this once to activate the merge driver:
#   git config merge.keepours.name "keep fork versions of generated files"
#   git config merge.keepours.driver true
xmlui/config.json merge=keepours
cities.json merge=keepours
cities/*/feeds.txt merge=keepours

# uv lockfile: keep the fork's version on upstream merges and collapse it in
# GitHub PR diffs (regenerate with `uv lock`).
uv.lock merge=keepours linguist-generated=true

# Per-city calendar artifacts: keep the fork's versions (regenerate with
# the daily "Auto-generate calendar metadata" pipeline).
rss/* merge=keepours linguist-generated=true
report/** merge=keepours linguist-generated=true
