BEGIN:VEVENT
SUMMARY:Trivia
DTSTART;TZID=America/Indiana/Indianapolis:20261124T190000
DTEND;TZID=America/Indiana/Indianapolis:20261124T210000
UID:cc0b1982aa639f122f0f2863767927e9@visitbloomington.com
DESCRIPTION:Tuesday\, Wednesday\, & Thursday we host live trivia from 7-9 
