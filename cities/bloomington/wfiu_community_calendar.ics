DTEND;TZID=America/Indiana/Indianapolis:20261023T193000
UID:edf6deae8668e2a2d672c965d636b632@ipm.org
ATTACH;FMTTYPE=image/jpeg:https://npr.brightspotcdn.com/dims4/default/7307
