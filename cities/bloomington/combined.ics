SUMMARY:A Court of Midnight and Magic: A Midnight Release Party for ACOTAR
  #7
DTSTART;TZID=America/Indiana/Indianapolis:20270111T000000
DTEND;TZID=America/Indiana/Indianapolis:20270111T213000
DTSTAMP:20261109T231553Z
