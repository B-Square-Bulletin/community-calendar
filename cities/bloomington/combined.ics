SUMMARY:Story: Sajik Kim exhibition
DTSTART;VALUE=DATE:20261109
DTEND;VALUE=DATE:20261110
DTSTAMP:20260818T163935Z
UID:20261109T050000Z-2385188@events.iu.edu
