SUMMARY:Happy Hour at Upland Brewing Co.
DTSTART;TZID=America/Indiana/Indianapolis:20261224T150000
DTEND;TZID=America/Indiana/Indianapolis:20261224T170000
DTSTAMP:20261031T043418Z
