SUMMARY:Taller Mensual de MamásConPoder
DTSTART;TZID=America/New_York:20260414T203000
DTEND;TZID=America/New_York:20260414T213000
DTSTAMP:20260407T031320Z
UID:77ab4jlcv44itke5o6r3bfbdfl@google.com
RECURRENCE-ID;TZID=America/New_York:20260414T203000
SEQUENCE:0
