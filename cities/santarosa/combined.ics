X-SOURCE-URLS:{"Uptowntheatrenapa": "https://www.uptowntheatrenapa.com/event/jam-cellars-presents-mariachi-sol-de-mexico-de-jose-hernandez-2/"}
X-SOURCE-ID:uptowntheatrenapa
X-SOURCE:Uptown Theatre Napa
X-SOURCE-URL:https://uptowntheatrenapa.com/events/
DTSTART;TZID=America/Los_Angeles:20260621T200000
DTEND;TZID=America/Los_Angeles:20260621T200000
