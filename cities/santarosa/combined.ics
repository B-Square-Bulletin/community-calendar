BEGIN:VEVENT
X-SOURCE-URLS:{"North Bay Bohemian": "https://www.northbayletterpressarts.org/for-sale/2026-wood-engraving", "Press Democrat": "https://www.pressdemocrat.com/events/#/details/wood-engraving-2-day-intensive-workshop/18131355/2026-04-19T10"}
X-SOURCE-URLS:{"North Bay Bohemian": "https://www.northbayletterpressarts.org/for-sale/2026-wood-engraving"}
