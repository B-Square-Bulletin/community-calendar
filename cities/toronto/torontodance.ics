 enue\, Toronto\, ON\, Canada;X-APPLE-RADIUS=100;X-TITLE=Goh Ballet Bayview
 :geo:43.767738,-79.385451
END:VEVENT
BEGIN:VEVENT
X-SOURCE:Toronto Dance
