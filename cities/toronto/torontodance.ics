LOCATION:Al Green Theatre\, 750 Spadina Ave\, Toronto\, Ontario\, M5S 2J2\,
  Canada
GEO:43.66642;-79.403909
X-APPLE-STRUCTURED-LOCATION;VALUE=URI;X-ADDRESS=750 Spadina Ave\, Toronto\,
  Ontario\, M5S 2J2\, Canada;X-APPLE-RADIUS=100;X-TITLE=Al Green Theatre:ge
 o:43.66642,-79.403909
END:VEVENT
