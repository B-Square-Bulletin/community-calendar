{
  "name": "community-calendar-js",
  "version": "0.1.0",
  "private": true,
  "description": "Node test harness for the community-calendar XMLUI date-window seam and static chrome checks",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:node": "vitest run",
    "test:browser": "playwright test",
    "bench": "node scripts/bench_collapse_long.js",
    "lint:js": "prettier --check \"xmlui/*.js\" \"tests/js/*.js\" \"scripts/*.js\" \"*.config.js\" \"eslint.config.mjs\" && eslint .",
    "format:js": "prettier --write \"xmlui/*.js\" \"tests/js/*.js\" \"scripts/*.js\" \"*.config.js\" \"eslint.config.mjs\" && eslint --fix ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vitest": "^3.2.4"
  }
}
